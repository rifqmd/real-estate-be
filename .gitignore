# .gitignore for Express + TypeScript project
# Recommended ignores for Node, build output, editor files, OS, logs, and sensitive env files

# Node modules
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Build output
dist/
build/
out/
lib/

# TypeScript
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# Test caches
.jest/cache/
jest-cache/

# Environment files
.env
.env.local
.env.*.local
.env.test

# Dependency directories for alternative package managers
.pnp.cjs
.pnp.loader.mjs
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# OS files
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Misc
.cache/
.turbo/
.parcel-cache/
.cache-loader/
/.eslintcache

# Certificates
*.pem

# Docker
docker-compose.override.yml

# Optional: ignore lockfiles if you do not intend to track them (usually leave tracked)
# pnpm-lock.yaml
# yarn.lock
